# Copier ce fichier en .env et ajuster si besoin. Toutes les variables sont
# facultatives : l'application tourne avec ses valeurs par defaut sans rien
# configurer (voir src/config/rules.js et src/config/urls.js).

# Port d'ecoute du serveur Waitless.
PORT=3000

# Cle de signature des sessions et des QR codes. A changer pour un vrai
# deploiement ; la valeur par defaut ("salle-du-temps-secret-de-demo") ne
# convient qu'a une demonstration locale.
WAITLESS_SECRET=change-moi

# Coupe l'affichage des e-mails simules dans la console (mettre "1" pour les
# masquer).
WAITLESS_SILENCIEUX=

# URL du capteur de la Salle du Temps. Vide = repli sur l'estimation interne.
# Avec docker-compose, le service "capteur" du docker-compose.yml fournit
# deja : http://capteur:4002
WAITLESS_CAPTEUR_URL=

# URL de la billetterie externe. Vide = repli sur data/billetterie.json, puis
# sur un statut deduit de l'e-mail. Avec docker-compose, le service
# "billetterie" fournit deja : http://billetterie:4001
WAITLESS_BILLETTERIE_URL=
